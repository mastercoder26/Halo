{
  "name": "halo",
  "version": "1.0.0",
  "private": true,
  "description": "Cursor-edge controls for macOS",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "generate:icon": "python3 scripts/generate-app-icon.py",
    "build:native": "node scripts/build-native.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "package": "npm run build && electron-builder --mac",
    "package:dir": "npm run build && electron-builder --mac --dir",
    "test": "node --test",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@rolldown/plugin-babel": "^0.2.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.3.0",
    "oxfmt": "^0.26.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.5.3",
    "vite": "^8.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.11.0+sha512-82gRxKrh/eY5UnNorkTFcdBQAGpgjWehkfGVqAGlJjejEtJZGGJUqjo3mbBTNbc5BTnPKGVtGPBZGhElujX5cw==",
  "build": {
    "appId": "com.akhilkonduru.halo",
    "productName": "Halo",
    "afterPack": "./scripts/adhoc-sign-macos.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "native",
        "to": "native",
        "filter": [
          "brightness",
          "modifier-state"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "app-icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Halo uses Apple Events to control playback in Music and adjust selected system controls from your cursor.",
        "NSAccessibilityUsageDescription": "Halo needs Accessibility access to change appearance and keyboard-backlight controls."
      }
    },
    "dmg": {
      "title": "Halo"
    }
  },
  "productName": "Halo"
}
